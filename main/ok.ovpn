###############################################################################
# SAMPLE OpenVPN client config — placeholders only. Do not commit real keys.
# Copy this file, fill in your server, and keep secrets out of git.
###############################################################################
client
dev tun
proto tcp
remote YOUR_VPN_HOST 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-128-CBC
auth SHA1
verb 3
# Place CA / cert / key in separate files or a private local profile, not in this repo.
# <ca>...</ca>
# <cert>...</cert>
# <key>...</key>
